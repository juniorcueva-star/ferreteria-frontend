# Copia este archivo como ".env.e2e" y usa solo las credenciales del backend E2E aislado.
# Nunca copies ADMIN_PASSWORD ni DEMO_PASSWORD de desarrollo.
E2E_ADMIN_PASSWORD=
# Contrasena E2E de vendedor1, vendedor2 y almacen1.
E2E_DEMO_PASSWORD=
# Estas URLs son obligatorias y no deben cambiarse.
E2E_URL=http://localhost:5174
E2E_API_URL=http://localhost:8081
# Guardia contra escrituras accidentales: solo en la base aislada.
E2E_ALLOW_WRITE=false
# Opcional: Chromium ya instalado (si no, se usa el de "npx playwright install chromium")
# CHROMIUM_PATH=
