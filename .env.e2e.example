# Copia este archivo como ".env.e2e" y pon las contrasenas de TU backend (las de su archivo .env).
# ADMIN_PASSWORD del backend
E2E_ADMIN_PASSWORD=
# DEMO_PASSWORD del backend (vendedor1, vendedor2 y almacen1)
E2E_DEMO_PASSWORD=
# Opcional: Chromium ya instalado (si no, se usa el de "npx playwright install chromium")
# CHROMIUM_PATH=
